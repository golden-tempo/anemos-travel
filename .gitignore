# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Build outputs
# Stray `go build` binary in the API package only — a bare `main` would also
# ignore Flutter's android/app/src/main/ directory.
src/packages/api/main
travel-route-planner
dist/
build/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local
.env.*.local

# Per-worktree dev-stack config (scripts/worktree.sh writes it) and the
# lane worktrees themselves (also in .git/info/exclude on harness machines)
.wt.env
LANE-BRIEF.md
.claude/worktrees/

# Docker volumes and data
docker-data/

# Temporary files
tmp/
temp/

# Air live reload (if you use it later)
.air.toml
tmp/

# Local-content seeding corpus (specs/local-content-seeding): real research
# never lands in git — only the format README and the _example fixture do.
content/*
!content/local/
content/local/*
!content/local/README.md
!content/local/_example/
# seeder ledgers are machine state, never committed (including the fixture's)
.ingested

# DevTools / profiling captures are large, machine-local, and regenerable —
# a 45 MB timeline is evidence for one afternoon, not a repo artifact.
performance-profile*.json
performance-profile*.json.gz
